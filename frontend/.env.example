# Codo Hub Frontend - Environment Variables
# Copy this file to .env and fill in the values

# API base URL
VITE_API_BASE_URL=http://localhost:3000/api

# Google OAuth Client ID (optional)
VITE_GOOGLE_CLIENT_ID=

# Firebase configuration (optional - fetched from backend /api/config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudflare Turnstile site key (optional). Empty = no CAPTCHA widget.
# Must match TURNSTILE_SECRET_KEY in backend/.env.
VITE_TURNSTILE_SITE_KEY=

# Kazakh Hub Backend - Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: JWT secret key for authentication token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here-change-this

# CORS: Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cookie security (MUST be "true" in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JWT token expiration (in minutes for access, days for refresh)
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=7

# Server port (default: 3000)
PORT=3000

# Firebase configuration (optional)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
# SMS verification at registration
#   firebase - Firebase Phone Auth sends the SMS (enable "Phone" provider in
#              Firebase Console; needs serviceAccountKey.json + FIREBASE_* above)
#   mobizon  - backend sends the code via Mobizon.kz (needs MOBIZON_API_KEY)
#   console  - dev only: the code is printed to the backend log
SMS_PROVIDER=console
MOBIZON_API_KEY=
MOBIZON_API_DOMAIN=api.mobizon.kz
MOBIZON_SENDER=
SMS_CODE_TTL_MINUTES=5
SMS_CODE_MAX_ATTEMPTS=5
SMS_RESEND_COOLDOWN_SECONDS=60

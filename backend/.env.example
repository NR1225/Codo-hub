# Codo Hub Backend - Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: JWT secret key for authentication token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here-change-this

# CORS: Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cookie security (MUST be "true" in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JWT token expiration (in minutes for access, days for refresh)
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=7

# Server port (default: 3000)
PORT=3000

# Firebase configuration (optional)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile CAPTCHA for register + login (optional).
# Empty = disabled. Pair with VITE_TURNSTILE_SITE_KEY in frontend/.env.
TURNSTILE_SECRET_KEY=

# HSTS (sent only on HTTPS requests; see docs/SECURITY-HSTS.md)
HSTS_MAX_AGE=86400
HSTS_INCLUDE_SUBDOMAINS=false

# Ортақ пакеттер: жобалар қолданатын npm / Python пакеттері серверде автоматты орнатылады.
# Осынша күн қолданылмаған жиынтық ұйықтатылады (дискіден өшеді, кэш қалады; 0 — ешқашан)
SHARED_PACKAGES_IDLE_DAYS=14
# Python пакеттерін requirements.txt / import-тар бойынша автоматты орнату
SHARED_PACKAGES_AUTO_PYTHON=true

# Burkit AI (Google Gemini) — key from https://aistudio.google.com
GEMINI_API_KEY=
# Model name (see the AI Studio model list)
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried in order when the main one is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Comma-separated user IDs allowed to use the shared GEMINI_API_KEY; everyone else enters their own key
BURKIT_SHARED_KEY_USER_IDS=
# Шағымдарды қолмен тексеретін модераторлар (user id, үтірмен)
MODERATOR_USER_IDS=
# Secret used to encrypt users' API keys in the DB (defaults to JWT_SECRET)
BURKIT_ENCRYPTION_KEY=

# Email (SMTP) — МІНДЕТТІ: кіру, тіркелу және поштаны ауыстыру кодтары тек осы арқылы барады
# Gmail: SMTP_PASSWORD — App Password (https://myaccount.google.com/apppasswords), кәдімгі құпия сөз емес
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Codo Hub
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# GitHub OAuth App (github.com/settings/developers → New OAuth App) — жабық репоны жүктеу үшін профильді қосу.
# Authorization callback URL = SITE_URL + /github/callback (жергілікті: http://localhost:5173/github/callback)
# SITE_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Міндетті емес: серверлік токен — ашық репо үшін GitHub шегі 60-тан 5000 сұрау/сағ-қа көтеріледі
# GITHUB_TOKEN=

# Мониторинг панелі (/admin/monitoring): әкімшілердің user id-лері, үтірмен
ADMIN_USER_IDS=
# Шабуыл белгісі (brute force, 5xx көбейсе, ұрланған токен) байқалғанда хат баратын пошта
ADMIN_ALERT_EMAIL=
# Тест аккаунттары (username не email, үтірмен) кез келген 6 таңбалы кодпен кіреді.
# Тек ALLOW_TEST_ACCOUNT_CODES=true болғанда; COOKIE_SECURE=true (production) болса — өшірулі.
ALLOW_TEST_ACCOUNT_CODES=false
TEST_ACCOUNTS=
# Мониторинг журналы қанша күн сақталады
SECURITY_EVENTS_RETENTION_DAYS=30
